<script>
  function setLang(l){
    document.querySelectorAll('.ru').forEach(el => el.hidden = (l === 'en'));
    document.querySelectorAll('.en').forEach(el => el.hidden = (l !== 'en'));
    document.documentElement.lang = l;
    document.getElementById('langRu').classList.toggle('active', l === 'ru');
    document.getElementById('langEn').classList.toggle('active', l === 'en');
    try{ localStorage.setItem('ob_lang', l); }catch(e){}
  }
  document.getElementById('langRu').addEventListener('click', () => setLang('ru'));
  document.getElementById('langEn').addEventListener('click', () => setLang('en'));
  let savedLang = 'ru';
  try{ savedLang = localStorage.getItem('ob_lang') || 'ru'; }catch(e){}
  setLang(savedLang);

  const toggle = document.getElementById('navToggle');
  const links = document.getElementById('navLinks');
  toggle.addEventListener('click', () => links.classList.toggle('open'));
  links.querySelectorAll('a').forEach(a => a.addEventListener('click', () => links.classList.remove('open')));

  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('revealed'); io.unobserve(e.target); } });
  }, { threshold: 0.12 });
  document.querySelectorAll('[data-reveal]').forEach(el => io.observe(el));
</script>

